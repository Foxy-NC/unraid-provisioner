          <?php else: foreach ($availableContainers as $c): ?>
          <label class="container-item" data-category="<?= htmlspecialchars($c['category']) ?>" style="display:block" title="<?= htmlspecialchars($c['description']) ?>">
            <input type="checkbox" name="containers[]" value="<?= htmlspecialchars($c['name']) ?>">
