<?php
$var = @parse_ini_file('/var/local/emhttp/var.ini');
$csrfToken = $var['csrf_token'] ?? '';
require_once '/usr/local/emhttp/plugins/unraid-provisioner/include/deploy-lib.php';

if (!is_dir(PROVISIONER_BASE)) {
    mkdir(PROVISIONER_BASE, 0755, true);
}

// Resolve a view token to a known profile path -- never trust a raw path
// from the query string, only accept one that matches an entry already
// returned by provisioner_list_profiles().
function provisioner_resolve_profile_token(string $token): ?array {
    $decoded = base64_decode($token, true);
    if ($decoded === false) return null;
    foreach (provisioner_list_profiles() as $p) {
        if ($p['path'] === $decoded) return $p;
    }
    return null;
}

// View: read the file now, rendered inline further down the page.
$viewedProfileName = null;
$viewedProfileJson = null;
if (isset($_GET['view'])) {
    $found = provisioner_resolve_profile_token($_GET['view']);
    if ($found !== null) {
        $viewedProfileName = $found['name'];
        $viewedProfileJson = file_get_contents($found['path']);
    }
}

$message = '';

// Handle form actions.
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $action = $_POST['action'] ?? '';
    try {
        if ($action === 'import_url' && !empty($_POST['url'])) {
            provisioner_import_from_url($_POST['url']);
            $message = "Profile imported from URL.";
        } elseif ($action === 'sync_git' && !empty($_POST['repo_url'])) {
            provisioner_sync_git_repo($_POST['repo_url']);
            $message = "Git repository synced.";
        } elseif ($action === 'deploy_now' && !empty($_POST['profile_path'])) {
            $profile = provisioner_load_profile($_POST['profile_path']);
            provisioner_deploy_profile($profile);
            $message = "Profile '{$profile['name']}' deployed.";
        } elseif ($action === 'set_autodeploy' && !empty($_POST['profile_path'])) {
            copy($_POST['profile_path'], PROVISIONER_AUTODEPLOY_FLAG);
            @unlink(PROVISIONER_AUTODEPLOY_DONE); // allow it to run again on next first boot
            $message = "Profile set for autodeploy on next array start.";
        } elseif ($action === 'clear_autodeploy') {
            @unlink(PROVISIONER_AUTODEPLOY_FLAG);
            $message = "Autodeploy disabled.";
        } elseif ($action === 'export_profile' && !empty($_POST['export_name'])) {
            $profile = provisioner_export_profile($_POST['export_name'], $_POST['export_description'] ?? '', !empty($_POST['anonymize']));
            $written = provisioner_save_profile($profile);
            $message = "Profile '{$profile['name']}' generated from this server ("
                . count($profile['plugins']) . " plugin(s), "
                . count($profile['containers']) . " container(s)). "
                . "Review it before reuse -- see " . htmlspecialchars($written) . ".";
        } elseif ($action === 'build_profile' && !empty($_POST['build_name'])) {
            $profile = provisioner_build_profile(
                $_POST['build_name'],
                $_POST['build_description'] ?? '',
                $_POST['plugins'] ?? [],
                $_POST['containers'] ?? [],
                !empty($_POST['anonymize'])
            );
            $written = provisioner_save_profile($profile);
            $message = "Custom profile '{$profile['name']}' built with "
                . count($profile['plugins']) . " plugin(s) and "
                . count($profile['containers']) . " container(s).";
        }
    } catch (Throwable $e) {
        $message = 'Error: ' . htmlspecialchars($e->getMessage());
    }
}

$profiles = provisioner_list_profiles();
$autodeployActive = is_file(PROVISIONER_AUTODEPLOY_FLAG);

$availablePlugins = provisioner_exported_plugins();
foreach ($availablePlugins as &$p) {
    $p['category'] = provisioner_plugin_category("/var/log/plugins/{$p['name']}.plg");
}
unset($p);
usort($availablePlugins, fn($a, $b) => strcasecmp($a['name'], $b['name']));
$pluginCategories = array_values(array_unique(array_column($availablePlugins, 'category')));
sort($pluginCategories);

$availableContainers = provisioner_exported_containers();
foreach ($availableContainers as &$c) {
    $c['category'] = provisioner_container_category($c['name']);
}
unset($c);
usort($availableContainers, fn($a, $b) => strcasecmp($a['name'], $b['name']));
$containerCategories = array_values(array_unique(array_column($availableContainers, 'category')));
sort($containerCategories);
?>

<style>
.provisioner-section { margin-bottom: 24px; }
.provisioner-table { width: 100%; border-collapse: collapse; }
.provisioner-table th, .provisioner-table td { padding: 6px 10px; border-bottom: 1px solid #444; text-align: left; }
.provisioner-msg { padding: 8px; margin-bottom: 16px; background: #2a2a2a; border-left: 3px solid #6a9; }
</style>

<h1>Unraid Provisioner</h1>

<?php if ($message): ?>
<div class="provisioner-msg"><?= $message ?></div>
<?php endif; ?>

<?php if ($viewedProfileJson !== null): ?>
<div class="provisioner-section">
  <h2>Viewing: <?= htmlspecialchars($viewedProfileName) ?></h2>
  <pre style="background:#111; padding:12px; overflow:auto; max-height:500px; border:1px solid #444;"><?= htmlspecialchars($viewedProfileJson) ?></pre>
  <p><a href="?">Close</a></p>
</div>
<?php endif; ?>

<div class="provisioner-section">
  <h2>Available profiles</h2>
  <table class="provisioner-table">
    <tr><th>Name</th><th>Version</th><th>Source</th><th>Plugins</th><th>Containers</th><th>Actions</th></tr>
    <?php foreach ($profiles as $p): $token = base64_encode($p['path']); ?>
    <tr>
      <td><a href="?view=<?= urlencode($token) ?>" title="View JSON"><?= htmlspecialchars($p['name']) ?></a></td>
      <td><?= htmlspecialchars($p['version']) ?></td>
      <td><?= htmlspecialchars($p['source']) ?></td>
      <td><?= count($p['plugins']) ?></td>
      <td><?= count($p['containers']) ?></td>
      <td>
        <form method="post" style="display:inline">
          <input type="hidden" name="csrf_token" value="<?=$csrfToken;?>">
          <input type="hidden" name="action" value="deploy_now">
          <input type="hidden" name="profile_path" value="<?= htmlspecialchars($p['path']) ?>">
          <button type="submit">Deploy now</button>
        </form>
        <form method="post" style="display:inline">
          <input type="hidden" name="csrf_token" value="<?=$csrfToken;?>">
          <input type="hidden" name="action" value="set_autodeploy">
          <input type="hidden" name="profile_path" value="<?= htmlspecialchars($p['path']) ?>">
          <button type="submit">Set as first-boot profile</button>
        </form>
        <a href="/plugins/unraid-provisioner/download-profile.php?token=<?= urlencode($token) ?>"><button type="button">Download</button></a>
      </td>
    </tr>
    <?php endforeach; ?>
    <?php if (empty($profiles)): ?>
    <tr><td colspan="6">No profile found. Import one below.</td></tr>
    <?php endif; ?>
  </table>
</div>

<div class="provisioner-section">
  <h2>Autodeploy on first boot</h2>
  <p>Status: <strong><?= $autodeployActive ? 'Active' : 'Inactive' ?></strong></p>
  <?php if ($autodeployActive): ?>
  <form method="post">
          <input type="hidden" name="csrf_token" value="<?=$csrfToken;?>">
    <input type="hidden" name="action" value="clear_autodeploy">
    <button type="submit">Disable autodeploy</button>
  </form>
  <?php endif; ?>
</div>

<div class="provisioner-section">
  <h2>Generate a profile from this server</h2>
  <p><em>Captures currently installed plugins and running containers into a new profile. Review the result before deploying it elsewhere -- plugin URLs and container settings are captured best-effort from the live host.</em></p>
  <form method="post">
          <input type="hidden" name="csrf_token" value="<?=$csrfToken;?>">
    <input type="hidden" name="action" value="export_profile">
    <input type="text" name="export_name" placeholder="profile-name" style="width:200px" required>
    <input type="text" name="export_description" placeholder="Description (optional)" style="width:300px">
    <label><input type="checkbox" name="anonymize" value="1"> Anonymize secrets in output</label>
    <button type="submit">Generate profile</button>
  </form>
</div>

<div class="provisioner-section">
  <h2>Build a custom profile</h2>
  <p><em>Pick which of this host's installed plugins and existing containers should be included in a new profile.</em></p>
  <form method="post">
          <input type="hidden" name="csrf_token" value="<?=$csrfToken;?>">
    <input type="hidden" name="action" value="build_profile">
    <p>
      <input type="text" name="build_name" placeholder="profile-name" style="width:200px" required>
      <input type="text" name="build_description" placeholder="Description (optional)" style="width:300px">
    </p>
    <p><label><input type="checkbox" name="anonymize" value="1"> Anonymize secrets in output</label></p>

    <div style="display:flex; gap:32px; flex-wrap:wrap;">
      <div style="flex:1; min-width:280px;">
        <h4>Plugins</h4>
        <?php if (count($pluginCategories) > 1): ?>
        <select onchange="provFilter(this,'plugin-item')" style="margin-bottom:8px">
          <option value="">All categories</option>
          <?php foreach ($pluginCategories as $cat): ?>
          <option value="<?= htmlspecialchars($cat) ?>"><?= htmlspecialchars($cat) ?></option>
          <?php endforeach; ?>
        </select>
        <?php endif; ?>
        <div id="plugin-list">
          <?php if (empty($availablePlugins)): ?>
          <p><em>No plugins detected on this host.</em></p>
          <?php else: foreach ($availablePlugins as $p): ?>
          <label class="plugin-item" data-category="<?= htmlspecialchars($p['category']) ?>" style="display:block">
            <input type="checkbox" name="plugins[]" value="<?= htmlspecialchars($p['name']) ?>">
            <?= htmlspecialchars($p['name']) ?>
            <span style="opacity:0.6">(<?= htmlspecialchars($p['category']) ?>)</span>
          </label>
          <?php endforeach; endif; ?>
        </div>
      </div>

      <div style="flex:1; min-width:280px;">
        <h4>Containers</h4>
        <?php if (count($containerCategories) > 1): ?>
        <select onchange="provFilter(this,'container-item')" style="margin-bottom:8px">
          <option value="">All categories</option>
          <?php foreach ($containerCategories as $cat): ?>
          <option value="<?= htmlspecialchars($cat) ?>"><?= htmlspecialchars($cat) ?></option>
          <?php endforeach; ?>
        </select>
        <?php endif; ?>
        <div id="container-list">
          <?php if (empty($availableContainers)): ?>
          <p><em>No containers detected on this host.</em></p>
          <?php else: foreach ($availableContainers as $c): ?>
          <label class="container-item" data-category="<?= htmlspecialchars($c['category']) ?>" style="display:block">
            <input type="checkbox" name="containers[]" value="<?= htmlspecialchars($c['name']) ?>">
            <?= htmlspecialchars($c['name']) ?>
            <span style="opacity:0.6">(<?= htmlspecialchars($c['image']) ?> -- <?= htmlspecialchars($c['category']) ?>)</span>
          </label>
          <?php endforeach; endif; ?>
        </div>
      </div>
    </div>

    <p><button type="submit">Build profile</button></p>
  </form>
</div>

<script>
function provFilter(select, cls) {
  var val = select.value;
  document.querySelectorAll('.' + cls).forEach(function (el) {
    el.style.display = (!val || el.dataset.category === val) ? 'block' : 'none';
  });
}
</script>

<div class="provisioner-section">
  <h2>Import a profile from a URL</h2>
  <form method="post">
          <input type="hidden" name="csrf_token" value="<?=$csrfToken;?>">
    <input type="hidden" name="action" value="import_url">
    <input type="text" name="url" placeholder="https://.../profile.json" style="width:400px">
    <button type="submit">Import</button>
  </form>
</div>

<div class="provisioner-section">
  <h2>Sync a profile library (Git repository)</h2>
  <form method="post">
          <input type="hidden" name="csrf_token" value="<?=$csrfToken;?>">
    <input type="hidden" name="action" value="sync_git">
    <input type="text" name="repo_url" placeholder="https://github.com/org/profiles-repo.git" style="width:400px">
    <button type="submit">Sync</button>
  </form>
  <p><em>The repository must contain profiles under <code>profiles/*.json</code>.</em></p>
</div>
