<script>
function provisionerViewProfile(token, name) {
  var overlay = document.getElementById('provisioner-overlay');
  var title = document.getElementById('provisioner-overlay-title');
  var content = document.getElementById('provisioner-overlay-content');
  title.textContent = name;
  content.textContent = 'Loading...';
  overlay.style.display = 'block';
  fetch('/plugins/unraid-provisioner/view-profile.php?token=' + token)
    .then(function (r) { return r.text(); })
    .then(function (text) {
      try {
        content.textContent = JSON.stringify(JSON.parse(text), null, 2);
      } catch (e) {
        content.textContent = text;
      }
    })
    .catch(function () {
      content.textContent = 'Failed to load profile.';
    });
}
function provisionerCloseOverlay() {
  document.getElementById('provisioner-overlay').style.display = 'none';
}

function provisionerSearch(input, itemClass, groupClass) {
  var q = input.value.toLowerCase();
  document.querySelectorAll('.' + itemClass).forEach(function (el) {
    var match = !q || (el.dataset.search || '').indexOf(q) !== -1;
    el.style.display = match ? 'block' : 'none';
  });
  document.querySelectorAll('.' + groupClass).forEach(function (group) {
    var anyVisible = Array.prototype.some.call(group.querySelectorAll('.' + itemClass), function (el) {
      return el.style.display !== 'none';
    });
    group.style.display = anyVisible ? '' : 'none';
  });
}

function provisionerToggleAll(itemClass, checked) {
  document.querySelectorAll('.' + itemClass).forEach(function (el) {
    if (el.style.display !== 'none') {
      var cb = el.querySelector('input[type=checkbox]');
      if (cb) cb.checked = checked;
    }
  });
}

function provisionerUpdateCount(itemClass, countId) {
  var n = document.querySelectorAll('.' + itemClass + ' input[type=checkbox]:checked').length;
  var el = document.getElementById(countId);
  if (el) el.textContent = n + ' selected';
}

function provisionerToggleMenu(id) {
  document.querySelectorAll('.prov-dropdown.open').forEach(function (el) {
    if (el.id !== id) el.classList.remove('open');
  });
  var el = document.getElementById(id);
  if (el) el.classList.toggle('open');
}
document.addEventListener('click', function (e) {
  if (!e.target.closest('.prov-actions-menu')) {
    document.querySelectorAll('.prov-dropdown.open').forEach(function (el) { el.classList.remove('open'); });
  }
});
</script>

