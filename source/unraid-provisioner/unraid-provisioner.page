<!-- Preview overlay: loaded via AJAX so viewing a profile never navigates
     away from the plugin page (avoids Unraid's "External Link" prompt and
     the extra tab that came with a plain <a href> to a different path). -->
<div id="provisioner-overlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.7); z-index:9999;">
  <div style="background:#1a1a1a; border:1px solid #555; max-width:800px; margin:60px auto; padding:20px; max-height:80vh; display:flex; flex-direction:column;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
      <h3 id="provisioner-overlay-title" style="margin:0;"></h3>
      <button type="button" onclick="provisionerCloseOverlay()">Close</button>
    </div>
    <pre id="provisioner-overlay-content" style="background:#111; padding:12px; overflow:auto; border:1px solid #444; flex:1;"></pre>
  </div>
</div>

<script>
function provisionerViewProfile(token, name) {
  var overlay = document.getElementById('provisioner-overlay');
  var title = document.getElementById('provisioner-overlay-title');
  var content = document.getElementById('provisioner-overlay-content');
  title.textContent = name;
  content.textContent = 'Loading...';
  overlay.style.display = 'block';
  fetch('/plugins/unraid-provisioner/view-profile.php?token=' + token)
    .then(function (r) { return r.text(); })
    .then(function (text) {
      try {
        content.textContent = JSON.stringify(JSON.parse(text), null, 2);
      } catch (e) {
        content.textContent = text;
      }
    })
    .catch(function () {
      content.textContent = 'Failed to load profile.';
    });
}
function provisionerCloseOverlay() {
  document.getElementById('provisioner-overlay').style.display = 'none';
}
</script>

