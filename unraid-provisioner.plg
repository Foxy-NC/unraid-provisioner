<?xml version="1.0" standalone="yes"?>

<!DOCTYPE PLUGIN [
<!ENTITY name      "unraid-provisioner">
<!ENTITY author    "Foxy-NC">
<!ENTITY version   "2026.07.28">
<!ENTITY github     "&author;/&name;">
<!ENTITY launch     "Settings/unraid-provisioner">
<!ENTITY pluginURL  "https://raw.githubusercontent.com/&github;/master/&name;.plg">
<!ENTITY supportURL "https://github.com/&github;">
<!ENTITY iconURL    "unraid-provisioner.png">
<!ENTITY MD5        "ec244a13b22f7bb5ee279156674fe8db">
]>

<PLUGIN name="&name;"
        author="&author;"
        version="&version;"
        pluginURL="&pluginURL;"
        support="&supportURL;"
        icon="&iconURL;"
        launch="&launch;"
        min="6.12">

  <CHANGES>
###2026.07.28
- Provision Unraid servers from reusable plugin+container profiles.
  </CHANGES>

  <!-- Download: fetch the payload, verified against its MD5.
       Always pulled from the master branch's current content rather than
       a versioned Release, so updating just means committing a new .txz
       to master -- no tag/release bump needed for the download itself. -->
  <FILE Name="/boot/config/plugins/&name;/&name;.txz">
    <URL>https://raw.githubusercontent.com/&github;/master/&name;.txz</URL>
    <MD5>&MD5;</MD5>
  </FILE>

  <!-- Install: unpack the payload (page, include/, scripts/, event/).
       Name here is the temp script path Unraid writes the Inline content
       to before executing it with Run — it is NOT a download target. -->
  <FILE Name="/tmp/&name;-install" Run="/bin/bash">
    <INLINE>
set -e
PKG="/boot/config/plugins/&name;/&name;.txz"
if [ ! -s "$PKG" ]; then
  echo "ERROR: $PKG missing or empty, cannot install &name;."
  exit 1
fi
xz -dc "$PKG" | tar -xf - -C /
mkdir -p /boot/config/plugins/&name;/profiles
mkdir -p /boot/config/plugins/&name;/library
chmod +x /usr/local/emhttp/plugins/&name;/scripts/*.php
chmod +x /usr/local/emhttp/plugins/&name;/event/started
echo "&name; &version; installed."
    </INLINE>
  </FILE>

  <!-- Remove: undo everything the install did -->
  <FILE Name="/tmp/&name;-remove" Run="/bin/bash" Method="remove">
    <INLINE>
rm -rf /usr/local/emhttp/plugins/&name;
rm -rf /boot/config/plugins/&name;
echo "&name; removed."
    </INLINE>
  </FILE>

</PLUGIN>
